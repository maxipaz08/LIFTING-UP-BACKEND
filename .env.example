# Puerto donde correrá la API (por defecto: 5000)
PORT=5000

# Conexión a Base de Datos MySQL en Aiven Cloud
DB_HOST=lifti-pazmax563-4588.i.aivencloud.com
DB_PORT=18946
DB_USER=avnadmin
DB_PASSWORD=tu_password_aiven
DB_NAME=defaultdb

# Clave secreta para tokens y autenticación
JWT_SECRET=tu_clave_secreta_jwt

# API Key de Brevo (Sendinblue) para envío de correos y código de verificación OTP
BREVO_API_KEY=tu_brevo_api_key_aqui

# Configuración adicional del remitente
EMAIL_USER=liftingup.app@gmail.com
EMAIL_FROM="LIFTING UP <liftingup.app@gmail.com>"
